# ==============================================================================
# ABHEDYA-NET: Environment Configuration Template
# ==============================================================================

# Core System
PROJECT_NAME=ABHEDYA-NET
VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL / SQLite)
# SQLite default: sqlite:///./chronos_ws.db
# PostgreSQL example: postgresql://chronos:defence_secret@localhost:5432/chronos_ws
DATABASE_URL=sqlite:///./chronos_ws.db

# Authentication & Security
SECRET_KEY=chronos-ws-super-secret-key-defence-platform
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI & LLM Reasoning Engine Configuration
# Supported options: RULE_BASED (deterministic fallback), OLLAMA (local LLM), OPENAI
LLM_PROVIDER=RULE_BASED
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=

# ML World Model Configuration
SEQUENCE_LENGTH=10
INPUT_DIM=19
HIDDEN_DIM=64
MODEL_CHECKPOINT_PATH=checkpoints/world_model.pth

# Deception Honeypot / Decoy Simulated Ports
DECOY_DB_PORT=5433
DECOY_API_PORT=8081
DECOY_ADMIN_PORT=8082

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
